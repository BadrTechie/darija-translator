{
  "manifest_version": 3,
  "name": "Darija Translator Side Panel",
  "version": "1.0.0",
  "description": "Translate highlighted webpage text into Moroccan Darija.",
  "permissions": ["contextMenus", "sidePanel", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "service-worker.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Darija Translator" }
}
