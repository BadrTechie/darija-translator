# Copy to server.env for local development. Never put real values in Git.
TRANSLATOR_DEMO_USERNAME=local-demo-user
TRANSLATOR_DEMO_PASSWORD=replace-with-a-local-password
keystore_password=replace-with-a-different-local-password
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-3.1-flash-lite
