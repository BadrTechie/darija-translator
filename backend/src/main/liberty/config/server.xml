<?xml version="1.0" encoding="UTF-8"?>
<server description="Darija Translator backend">
    <featureManager>
        <feature>restfulWS-3.1</feature>
        <feature>jsonb-3.0</feature>
        <feature>jsonp-2.1</feature>
        <!-- Provides the Jakarta Authentication SPI used by BasicAuthenticationModule. -->
        <feature>appAuthentication-3.0</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="${http.port}"
                  httpsPort="${https.port}" />

    <webApplication id="darija-translator-backend"
                    location="darija-translator-backend.war"
                    contextRoot="/" />
</server>
